# Copy to .env.local for development.

# Emails that get the admin (curation) role when they sign up. Comma-separated.
CURATIT_ADMIN_EMAILS=

# HMAC secret for signed cursors. Required in production; generated into
# data/.secret automatically in development.
CURATIT_SECRET=

# Local SQLite file (development/demo only). Defaults to data/curatit.db.
CURATIT_DB_PATH=

# Public URL used by RSS and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
