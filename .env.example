# Copy to .env.local and fill in. .env*.local is gitignored; never commit real values.

# Supabase (public: these reach the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Project Settings → API keys → Secret keys). Used by the Creative
# Intelligence worker and the reconcile cron. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Vercel cron authentication (Vercel sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# MCP server and research API (docs/mcp/operations.md). The secret key above is needed too:
# token checks and rate limits run as service_role.
# This deployment's canonical origin, used for OAuth resource metadata and CORS
CURATIT_PUBLIC_BASE_URL=https://curatit.vercel.app
# Signs search cursors: 32+ random bytes, e.g. `openssl rand -hex 32`
CURATIT_MCP_SIGNING_SECRET=
# Supabase Auth's issuer (https://<ref>.supabase.co/auth/v1) once the project's OAuth 2.1 server
# is on; leave unset to keep OAuth off (personal access tokens still work)
CURATIT_OAUTH_ISSUER=
# Extra browser origins allowed to call /mcp, comma-separated (the base URL is always allowed)
CURATIT_ALLOWED_ORIGINS=
# debug | info | warn | error
CURATIT_LOG_LEVEL=info

# Creative Intelligence (docs/creative-intelligence.md)
# false stops the worker, import queuing and the cron; the cron also needs it to be true
CREATIVE_ANALYSIS_ENABLED=
# Let the daily reconcile queue posts (otherwise it only reports what's due)
CREATIVE_RECONCILE_APPLY=
# claude-cli (the local Claude Code subscription) or mock
CREATIVE_ANALYSIS_PROVIDER=claude-cli
# A model alias or full name for claude --model
CREATIVE_ANALYSIS_MODEL=sonnet
CLASSIFIER_CONCURRENCY=2
CREATIVE_MAX_USD_PER_POST=0.5
CREATIVE_MAX_USD_PER_RUN=2
CREATIVE_SLIDES_PER_CALL=10
CREATIVE_MODEL_TIMEOUT_MS=300000
# Publish clean results without review; leave unset until the evaluation supports it
CREATIVE_ANALYSIS_AUTO_PUBLISH=
# Allow `work --provider mock` to save made-up analyses (staging only)
CREATIVE_ALLOW_MOCK_WRITES=
