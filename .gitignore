# Build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.production
.env*.local

# macOS-specific files
.DS_Store

# VS Code settings
.vscode/

# Git-specific files
.git/
.gitconfig
.gitignore

# Other editor/IDE settings
.idea/
*.iml

# Temporary/system files
*.swp
*.tmp
Thumbs.db

# Library post images are downloaded locally and kept out of git
public/images/library/
# Staging copy of the `library` storage bucket (scripts/download-library-images.mjs)
data/storage/

# Supabase CLI state (linked project, pooler URL)
supabase/.temp/
supabase/.branches/

# Raw Apify exports and the seed built from them: they hold commenters'
# usernames and comments, so they stay out of this public repo
data/instagram/
supabase/seed.sql

# Creative Intelligence comparison output (npm run creative:compare): analyses of real posts, rater sheets
data/creative-eval/

# Workspace package builds
packages/*/dist

# The PostHog wizard's working files
.posthog-wizard-cache/

# Hybrid search models, fetched at build (npm run search:models)
/models/

# Git worktrees live inside the repo here (AGENTS.md), never beside it
/.claude/worktrees/
.supabase-usage/
