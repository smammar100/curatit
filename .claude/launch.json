{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "curatit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "curatit-email",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "email:dev"
      ],
      "port": 3001,
      "env": {
        "EMAIL_ASSET_URL": "http://localhost:3000"
      }
    }
  ]
}
