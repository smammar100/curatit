{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "curatit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "curatit-dev-qa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3010"
      ],
      "port": 3010,
      "env": {
        "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN": "",
        "NEXT_PUBLIC_POSTHOG_HOST": "",
        "RESEND_API_KEY": ""
      }
    },
    {
      "name": "curatit-email",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "email:dev"
      ],
      "port": 3001,
      "env": {
        "EMAIL_ASSET_URL": "http://localhost:3000"
      }
    }
  ]
}
